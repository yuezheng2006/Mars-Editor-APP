{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VinsEditor",
  "version": "0.1.2",
  "identifier": "com.mars-editor.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5273",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "VinsEditor",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "longDescription": "VinsEditor：Markdown 写作，一键转成公众号内联样式富文本 —— 粘进公众号编辑器即可无损还原，也可以直接推送到草稿箱。草稿不藏在应用里，就是磁盘上的普通 .md 文件。",
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/whyubel1eve/Mars-Editor-APP/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NUQzNkY2MzQ1MzU4MTUKUldRVldGTTA5alpkMXZLRXhUOU1mTGpWWWlzK1VXMlJFYkZoZjVyN2x2RSsvQkdSeGhZVVl1aG4K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
